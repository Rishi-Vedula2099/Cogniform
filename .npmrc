# Hoist Prisma-related packages so the generated client is resolvable from apps/api
public-hoist-pattern[]=*prisma*
# Use hoisted linker to avoid cross-workspace native module resolution issues
# (Prisma engine binaries, argon2, sharp, swc, etc.)
node-linker=hoisted
# Strict peer deps would block many valid monorepo setups
strict-peer-dependencies=false
