# =============================================================================
# Cogniform — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cogniform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cogniform
R2_PUBLIC_URL=

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Integrations ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NOTION_API_KEY=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
