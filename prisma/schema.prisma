generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  CHECKBOX
  RADIO
  DROPDOWN
  DATE
  TIME
  FILE_UPLOAD
  RATING
  SIGNATURE
  ADDRESS
  NUMBER
  PASSWORD
  URL
  COLOR_PICKER
  MATRIX
}

enum ValidationType {
  REQUIRED
  MIN_LENGTH
  MAX_LENGTH
  MIN_VALUE
  MAX_VALUE
  REGEX
  EMAIL_FORMAT
  PHONE_FORMAT
  URL_FORMAT
  CUSTOM
}

enum LogicOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  GREATER_THAN
  LESS_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN_OR_EQUAL
  IS_EMPTY
  IS_NOT_EMPTY
  STARTS_WITH
  ENDS_WITH
}

enum LogicAction {
  SHOW
  HIDE
  REQUIRE
  DISABLE
  SET_VALUE
}

enum IntegrationType {
  SLACK
  DISCORD
  GMAIL
  GOOGLE_SHEETS
  NOTION
  WEBHOOK
  ZAPIER
  MAKE
}

enum WebhookEvent {
  FORM_SUBMITTED
  FORM_UPDATED
  FORM_DELETED
  FORM_PUBLISHED
  MEMBER_INVITED
  MEMBER_REMOVED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  REVOKE
  PUBLISH
  ARCHIVE
  EXPORT
}

// ── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaces    WorkspaceMember[]
  forms         Form[]
  auditLogs     AuditLog[]
  notifications Notification[]
  invitedMembers WorkspaceMember[] @relation("Inviter")
  createdVersions FormVersion[]    @relation("VersionCreator")

  @@index([email])
}

// ── Workspaces & Teams ──────────────────────────────────────────────────────

model Workspace {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     WorkspaceMember[]
  forms       Form[]
  integrations Integration[]
  webhooks    Webhook[]

  @@index([slug])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(VIEWER)
  invitedBy   String?
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser User?   @relation("Inviter", fields: [invitedBy], references: [id])

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

// ── Forms ───────────────────────────────────────────────────────────────────

model Form {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      FormStatus @default(DRAFT)
  slug        String     @unique
  workspaceId String
  creatorId   String
  password    String?    // For password-protected forms
  isPublished Boolean    @default(false)
  publishedAt DateTime?
  closedAt    DateTime?
  customDomain String?
  allowEmbed  Boolean    @default(true)
  captchaEnabled Boolean @default(false)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User       @relation(fields: [creatorId], references: [id])
  sections    FormSection[]
  responses   Response[]
  analytics   FormAnalytics[]
  versions    FormVersion[]
  webhooks    Webhook[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([slug])
  @@index([status])
}

model FormSection {
  id        String  @id @default(cuid())
  formId    String
  title     String?
  description String?
  order     Int
  isConditional Boolean @default(false)

  form      Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields    FormField[]

  @@index([formId])
}

model FormField {
  id          String      @id @default(cuid())
  sectionId   String
  type        FieldType
  label       String
  placeholder String?
  helpText    String?
  required    Boolean     @default(false)
  defaultValue String?
  order       Int
  width       Int         @default(100) // Percent width for layout
  options     Json?       // For radio, checkbox, dropdown options
  settings    Json?       // Field-specific settings (e.g., min/max for rating)
  isConditional Boolean   @default(false)

  section     FormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  validations FieldValidation[]
  logicRules  FieldLogicRule[]
  logicTargetRules FieldLogicRule[] @relation("LogicTarget")
  answerValues ResponseAnswer[]

  @@index([sectionId])
}

model FieldValidation {
  id          String         @id @default(cuid())
  fieldId     String
  type        ValidationType
  value       String?        // The validation value (e.g., regex pattern, min value)
  message     String         // Error message to display

  field       FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
}

model FieldLogicRule {
  id          String        @id @default(cuid())
  fieldId     String
  action      LogicAction
  operator    LogicOperator
  value       String?       // Value to compare against
  targetFieldId String?     // Field to act on
  conditions  Json?         // Multiple conditions (AND/OR)
  order       Int           @default(0)

  field       FormField     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  targetField FormField?    @relation("LogicTarget", fields: [targetFieldId], references: [id])

  @@index([fieldId])
}

// ── Responses ────────────────────────────────────────────────────────────────

model Response {
  id          String    @id @default(cuid())
  formId      String
  respondentIp String?
  userAgent   String?
  acceptLanguage String?
  geoLocation Json?
  device      Json?     // { type: 'mobile'|'desktop'|'tablet', brand, model, os }
  browser     Json?     // { name, version, engine }
  completedAt DateTime?
  startedAt   DateTime  @default(now())
  isCompleted Boolean   @default(false)
  duration    Int?      // Time in seconds to complete
  metadata    Json?     // Extra data like UTM params, referrer

  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     ResponseAnswer[]

  @@index([formId])
  @@index([startedAt])
  @@index([completedAt])
  @@index([isCompleted])
}

model ResponseAnswer {
  id          String    @id @default(cuid())
  responseId  String
  fieldId     String
  value       Json?     // The answer value (text, array for multi-select, JSON for complex)
  fileUrl     String?   // For file upload fields
  fileName    String?   // Original file name
  fileSize    Int?      // File size in bytes

  response    Response  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field       FormField @relation(fields: [fieldId], references: [id])

  @@unique([responseId, fieldId])
  @@index([responseId])
  @@index([fieldId])
}

// ── Analytics ────────────────────────────────────────────────────────────────

model FormAnalytics {
  id          String    @id @default(cuid())
  formId      String
  date        DateTime  @default(now())
  views       Int       @default(0)
  responses   Int       @default(0)
  completions Int       @default(0)
  dropoffs    Json?     // { step1: 10, step2: 5, ... }
  devices     Json?     // { mobile: 45, desktop: 120, tablet: 15 }
  browsers    Json?     // { chrome: 100, firefox: 30, safari: 50 }
  countries   Json?     // { US: 50, IN: 30, GB: 20 }
  referrers   Json?     // { direct: 20, google: 10, twitter: 5 }

  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, date])
  @@index([formId])
  @@index([date])
}

// ── Integrations & Webhooks ──────────────────────────────────────────────────

model Integration {
  id          String           @id @default(cuid())
  workspaceId String
  type        IntegrationType
  name        String
  config      Json             // Encrypted integration config (tokens, keys, etc.)
  isEnabled   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([type])
}

model Webhook {
  id          String        @id @default(cuid())
  workspaceId String
  formId      String?       // Null = global webhook for all forms
  url         String
  secret      String        // HMAC signing secret
  events      WebhookEvent[]
  isEnabled   Boolean       @default(true)
  lastTriggeredAt DateTime?
  successCount  Int          @default(0)
  failureCount  Int          @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form        Form?         @relation(fields: [formId], references: [id])

  @@index([workspaceId])
  @@index([formId])
}

// ── Audit Logs ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  resource    String      // e.g., "form", "workspace", "integration"
  resourceId  String?     // ID of the resource
  details     Json?       // What changed
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    // e.g., "form_response", "team_invite", "system"
  title       String
  message     String
  data        Json?     // Additional data for the notification
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ── Form Versions ────────────────────────────────────────────────────────────

model FormVersion {
  id          String    @id @default(cuid())
  formId      String
  version     Int
  schema      Json      // Full form schema snapshot
  changeLog   String?
  createdBy   String
  createdAt   DateTime  @default(now())

  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("VersionCreator", fields: [createdBy], references: [id])

  @@unique([formId, version])
  @@index([formId])
}
